    <deployment_guide>
        <title>Deployment Instructions</title>
        <local_deployment>
            <prerequisites>
                <item>Python 3.7 or higher</item>
                <item>pip package manager</item>
                <item>Virtual environment (recommended)</item>
                <item>Modern web browser</item>
            </prerequisites>
            <steps>
                <step number="1">Clone repository: git clone https://github.com/Dowhith18/IAWFPIDM.git</step>
                <step number="2">Create virtual environment: python -m venv venv</step>
                <step number="3">Activate environment: venv\Scripts\activate (Windows) or source venv/bin/activate (Linux/Mac)</step>
                <step number="4">Install dependencies: pip install -r requirements.txt</step>
                <step number="5">Run application: python app.py</step>
                <step number="6">Access at: http://127.0.0.1:5000</step>
            </steps>
        </local_deployment>
        <cloud_deployment>
            <platform>Vercel</platform>
            <steps>
                <step number="1">Install Vercel CLI: npm install -g vercel</step>
                <step number="2">Login to Vercel: vercel login</step>
                <step number="3">Deploy: vercel</step>
                <step number="4">Production deployment: vercel --prod</step>
            </steps>
            <configuration>vercel.json file included in project</configuration>
        </cloud_deployment>
    </deployment_guide>

