    <data_architecture>
        <title>Data Architecture &amp; Database Design</title>
        <database_structure>
            <component name="DTC Database">
                <format>JSON</format>
                <file>dtc_data.json</file>
                <records>6000+ diagnostic trouble codes</records>
                <schema>
                    <field name="code">DTC code (e.g., P0171)</field>
                    <field name="description">Detailed fault description</field>
                    <field name="system">Automotive system category</field>
                    <field name="severity">High, Medium, Low</field>
                    <field name="symptoms">Observable symptoms</field>
                    <field name="causes">Probable causes</field>
                    <field name="solutions">Recommended fixes</field>
                </schema>
            </component>
            <component name="User Management">
                <format>In-memory dictionary (Production: Database)</format>
                <schema>
                    <field name="username">Unique user identifier</field>
                    <field name="password">Hashed password (plain text in demo)</field>
                    <field name="role">Admin, Technician, Viewer</field>
                    <field name="permissions">Access control list</field>
                </schema>
            </component>
            <component name="Vehicle Data">
                <format>JavaScript object (aiVehicleData)</format>
                <schema>
                    <field name="vin">Vehicle Identification Number</field>
                    <field name="model_code">Model identification</field>
                    <field name="odometer">Mileage reading</field>
                    <field name="battery_voltage">Real-time voltage</field>
                    <field name="engine_rpm">Engine speed</field>
                    <field name="electrical_health_score">0-100% health rating</field>
                </schema>
            </component>
            <component name="ECU Status">
                <format>JavaScript array</format>
                <records>15 ECU modules</records>
                <schema>
                    <field name="name">ECU identifier</field>
                    <field name="status">SUCCESS or DTC_FOUND</field>
                    <field name="fault_count">Number of active faults</field>
                    <field name="ai_risk_score">0-100% risk assessment</field>
                    <field name="predicted_issues">Array of predicted faults</field>
                </schema>
            </component>
            <component name="Fault Predictions">
                <format>JavaScript array</format>
                <schema>
                    <field name="fault_type">Short Circuit, Open Circuit, etc.</field>
                    <field name="location">Component location</field>
                    <field name="probability">0-1 confidence score</field>
                    <field name="severity">High, Medium, Low</field>
                    <field name="estimated_time_to_failure">Time prediction</field>
                </schema>
            </component>
        </database_structure>
        <data_flow>
            <flow_step>User Input → Flask Backend → Data Validation</flow_step>
            <flow_step>Data Processing → Pandas/NumPy Analysis → AI Model</flow_step>
            <flow_step>Prediction Results → JSON Response → Frontend Display</flow_step>
            <flow_step>Real-time Updates → WebSocket/Polling → Dashboard Refresh</flow_step>
        </data_flow>
    </data_architecture>

