    <application_architecture>
        <title>Application Architecture</title>
        <architecture_diagram>
            <layer name="Presentation Layer">
                <components>
                    <component>HTML5 Templates (Jinja2)</component>
                    <component>CSS3 Styling (Custom + Grid)</component>
                    <component>JavaScript (ES6+ with Chart.js)</component>
                    <component>Responsive Design Framework</component>
                </components>
                <responsibilities>User interface rendering, Client-side interactions, Data visualization</responsibilities>
            </layer>
            <layer name="Application Layer">
                <components>
                    <component>Flask 3.1.2 Web Framework</component>
                    <component>Route Handlers (/login, /dashboard, /dtc-lookup)</component>
                    <component>Session Management</component>
                    <component>Template Rendering Engine</component>
                </components>
                <responsibilities>Request routing, Session handling, Response generation</responsibilities>
            </layer>
            <layer name="Business Logic Layer">
                <components>
                    <component>Fault Prediction Engine</component>
                    <component>Anomaly Detection Module</component>
                    <component>Pattern Matching Algorithm</component>
                    <component>Risk Assessment Calculator</component>
                    <component>Data Processing (Pandas/NumPy)</component>
                </components>
                <responsibilities>AI/ML processing, Data analysis, Business rules</responsibilities>
            </layer>
            <layer name="Data Layer">
                <components>
                    <component>JSON Database (dtc_data.json)</component>
                    <component>User Data Store</component>
                    <component>Vehicle Metrics Cache</component>
                    <component>Session Storage</component>
                </components>
                <responsibilities>Data persistence, Retrieval, Caching</responsibilities>
            </layer>
        </architecture_diagram>
        <design_patterns>
            <pattern>MVC (Model-View-Controller)</pattern>
            <pattern>Repository Pattern for data access</pattern>
            <pattern>Factory Pattern for object creation</pattern>
            <pattern>Observer Pattern for real-time updates</pattern>
        </design_patterns>
    </application_architecture>

